{
  "realm": "auth-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "registrationEmailAsUsername": true,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrator"
      },
      {
        "name": "DISPATCHER",
        "description": "Dispatcher"
      },
      {
        "name": "COURIER",
        "description": "Courier"
      }
    ]
  },
  "clients": [
    {
      "clientId": "auth-service",
      "name": "Auth Service",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "auth-service-secret-change-in-prod",
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "auth-service-admin",
      "name": "Auth Service Admin",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "auth-service-admin-secret-change-in-prod",
      "publicClient": false,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    },
    {
      "clientId": "delivery-frontend",
      "name": "Delivery Frontend",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "*"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:3000/*"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ]
}